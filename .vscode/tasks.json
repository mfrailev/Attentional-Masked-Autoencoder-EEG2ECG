{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: Masked Autoencoder",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/O2",
                "/openmp:experimental",
                "/arch:AVX2",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "High-Performance Build for EEG Research"
        },
    ],
    "version": "2.0.0"
}